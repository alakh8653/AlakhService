# Details for the public site's legal pages and app-link files (deploy/site).
#
#   cp deploy/site-details.example.env deploy/site-details.env    # then fill in every value
#   python3 scripts/deploy/fill_site.py                            # or: make site-fill
#
# fill_site.py writes these into deploy/site/*.html and deploy/site/.well-known/, then lists anything
# still missing. Commit the filled pages: deploy.sh refuses to deploy a checkout with local changes.
# Everything here ends up on public web pages, so put no secrets in this file.
# The pages are drafts: have a lawyer review them before launch (docs/LEGAL_PAGES.md).

# --- Company (must match PLATFORM_LEGAL_NAME / PLATFORM_ADDRESS in .env.production, used on invoices)
COMPANY_LEGAL_NAME=
REGISTERED_ADDRESS=
# Corporate Identification Number (or LLPIN / registration number for other business types)
CIN=
# City whose courts have jurisdiction (Terms)
JURISDICTION_CITY=

# --- Grievance Officer (IT Rules 2021 and DPDP Act: a named person in India)
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_DESIGNATION=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=
GRIEVANCE_HOURS=Mon–Sat, 10:00–18:00 IST
# Who law enforcement contacts (Grievance page), e.g. "Asha Rao, legal@example.in"
NODAL_CONTACT=

# --- Support and dates
SUPPORT_EMAIL=
# When the Terms, Privacy and Refund pages take effect, e.g. 1 December 2026
EFFECTIVE_DATE=

# --- Privacy policy: who processes data for you, and how long it is kept
# e.g. "DigitalOcean, Bangalore (India)"
HOSTING_PROVIDER=
# MSG91 or Twilio (match SMS_PROVIDER)
SMS_PROVIDER_NAME=MSG91
# e.g. Amazon SES (Mumbai), Zoho Mail, Brevo
EMAIL_PROVIDER_NAME=
CHAT_RETENTION=180 days
SECURITY_LOG_RETENTION=1 year
# Match BACKUP_KEEP_DAYS in .env.production
BACKUP_RETENTION=14 days

# --- Refunds and Terms: must match what the code does
# Customer cancels less than CANCEL_FREE_HOURS (default 2) before the booking. payment_service keeps
# CANCEL_FEE_PERCENT of the payment: 0 (the default) -> "Full refund"; 50 -> "50% refund, because the
# Shop has kept the slot for you"; 100 -> "No refund, because the Shop has kept the slot for you".
LATE_CANCEL_REFUND=Full refund
# How long after the booking time a customer can raise a dispute, and how soon you decide it
DISPUTE_WINDOW=48 hours
DISPUTE_DECISION_TIME=7 days
# Minutes late before a Shop may treat the customer as a no-show (Terms)
NO_SHOW_GRACE_MINUTES=15

# --- App links (.well-known): open https://<DOMAIN>/b/... links in the app instead of the browser
# Play Console -> your app -> Test and release -> App integrity -> App signing key certificate ->
# SHA-256 certificate fingerprint (32 pairs like AB:CD:...). Add your upload key's too, separated by
# commas, if you test release builds you sideload.
ANDROID_SHA256_FINGERPRINT=
# Apple Developer -> Membership details -> Team ID (10 characters). Leave empty until the iOS app exists.
APPLE_TEAM_ID=
