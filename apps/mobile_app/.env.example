# Build-time settings of the app (read with String.fromEnvironment). Every one has a default in
# lib/, so set only what you change. Copy to .env and pass it to Flutter:
#
#   flutter run --dart-define-from-file=.env
#
# Release builds in CI take the same names from the repository variables (.github/workflows/mobile-ci.yml).

# API gateway origin. Android emulator: http://10.0.2.2:3000; a phone over USB: run
# `adb reverse tcp:3000 tcp:3000` and use http://localhost:3000.
API_BASE_URL=http://10.0.2.2:3000
# Public site with the Terms, Privacy and Refund pages.
LEGAL_BASE_URL=https://alakhservice.in
# Domain whose https links open the app (deploy/site/.well-known).
APP_LINK_DOMAIN=alakhservice.in
# Shown on the Help screen.
SUPPORT_EMAIL=support@alakhservice.in
SUPPORT_PHONE=+910000000000

# The Google Maps key is not a dart-define: put GOOGLE_MAPS_API_KEY in android/local.properties
# (see android/README.md) and ios/Flutter/Secrets.xcconfig (see ios/README.md).
