# =============================================================================
# AlakhService — production settings for one server (docker-compose.prod.yml)
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   nano .env.production           # fill in every REPLACE_ME, then:
#   make prod-preflight            # checks this file and the server before you deploy
#
# This file holds live secrets: never commit it (it is git-ignored), never paste it in chat,
# and keep an offline copy somewhere safe (a password manager). Losing JWT_SECRET_KEY signs
# everyone out; losing POSTGRES_PASSWORD locks you out of your own data.
#
# Format: KEY=value, one per line, no spaces around "=", no quotes needed. Do not use "$" in
# values (Docker Compose would treat it as a variable). Generate secrets with the commands shown;
# they produce letters and digits only, which is always safe here.
#
# [SECRET]   = keep private      [REQUIRED] = deploy refuses to run without it
# =============================================================================


# -----------------------------------------------------------------------------
# Domain and HTTPS
# -----------------------------------------------------------------------------

# [REQUIRED] Your domain, without https:// or www. The stack serves:
#   https://<DOMAIN>        public site: Terms, Privacy, Refunds, Grievance, account deletion, app links
#   https://api.<DOMAIN>    API (mobile app + dashboards talk to this)
#   https://shop.<DOMAIN>   shop owner dashboard
#   https://admin.<DOMAIN>  admin dashboard
# Create DNS "A" records for the bare domain (@), api, shop and admin pointing at this server's
# public IP first.
DOMAIN=REPLACE_ME.in

# [REQUIRED] Email for Let's Encrypt: it warns here if a certificate cannot be renewed.
ACME_EMAIL=REPLACE_ME@REPLACE_ME.in

# Who may open https://admin.<DOMAIN> and call the admin APIs, as space-separated IPs or
# CIDR ranges, e.g. "203.0.113.7/32 198.51.100.0/24". The default lets everyone through (the
# admin login and admin role still apply). Find your office IP at https://ifconfig.me
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0


# -----------------------------------------------------------------------------
# Core secrets (all [REQUIRED], all [SECRET])
# -----------------------------------------------------------------------------

# Signs and verifies sign-in tokens across every service and the gateway (32+ characters).
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_ME

# Lets services call each other's /internal routes (32+ random characters, a different value).
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=REPLACE_ME

# Bearer token Prometheus uses to read the gateway's /metrics (32+ characters, a different value).
# Generate: openssl rand -hex 32
METRICS_TOKEN=REPLACE_ME


# -----------------------------------------------------------------------------
# Database (PostgreSQL, runs on this server; never exposed to the internet)
# -----------------------------------------------------------------------------

# [REQUIRED] Database user name (letters, digits, underscore).
POSTGRES_USER=alakh

# [REQUIRED] [SECRET] Database password: letters and digits only (it goes inside a URL).
# Generate: openssl rand -hex 24
# Set it BEFORE the first deploy: PostgreSQL stores it on first start, and changing it here
# later does not change it in the database (see docs/DEPLOYMENT.md, "Changing secrets").
POSTGRES_PASSWORD=REPLACE_ME

# Name of the default database (each service also gets its own; leave as is).
POSTGRES_DB=alakhservice_db


# -----------------------------------------------------------------------------
# Web dashboards
# -----------------------------------------------------------------------------

# [REQUIRED] Browser origins allowed to call the API: exactly the two dashboards, comma-separated,
# with https:// and no trailing slash. Replace REPLACE_ME.in with your DOMAIN.
CORS_ORIGINS=https://shop.REPLACE_ME.in,https://admin.REPLACE_ME.in

# Page that password-reset emails link to. Default (leave it): https://<DOMAIN>/reset-password, an
# app link that opens the app, or lets the person (or a shop owner on a computer) reset it in the browser.
PASSWORD_RESET_URL=https://REPLACE_ME.in/reset-password

# The Terms and Privacy Policy version people accept at sign-up (GET /api/v1/legal/current). Change it
# (e.g. 2027-01) whenever deploy/site/terms.html or privacy.html changes materially: the apps then ask
# everyone to accept the new version.
TERMS_VERSION=2026-10


# -----------------------------------------------------------------------------
# Payments: Razorpay (https://dashboard.razorpay.com). Leave all three empty to offer cash only.
# -----------------------------------------------------------------------------

# Account & Settings > API Keys. Live keys start with rzp_live_ (real money);
# rzp_test_ keys are test mode (preflight warns).
RAZORPAY_KEY_ID=
# [SECRET] Shown once when you generate the key.
RAZORPAY_KEY_SECRET=
# [SECRET] Account & Settings > Webhooks > Add new webhook:
#   URL:     https://api.<DOMAIN>/api/v1/webhooks/razorpay
#   Secret:  the value below (generate: openssl rand -hex 24), pasted in both places
#   Events:  payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Stripe is not used in India; leave empty.
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# SMS: one-time sign-in codes, and booking updates for people without the app installed.
# Indian numbers only receive SMS from a DLT-registered sender id with registered templates (TRAI);
# see docs/DEPLOYMENT.md, "SMS". Without a provider, phone sign-in codes are NOT delivered.
# -----------------------------------------------------------------------------

# twilio, msg91 (recommended in India) or none.
SMS_PROVIDER=msg91

# MSG91 (https://control.msg91.com): API key, your 6-letter DLT sender id, and the DLT template id
# of each message (the texts to register are in docs/DEPLOYMENT.md). [SECRET] auth key.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_BOOKING_CONFIRMED=
MSG91_TEMPLATE_BOOKING_CANCELLED=
MSG91_TEMPLATE_BOOKING_REMINDER=
MSG91_TEMPLATE_BOOKING_REFUNDED=
MSG91_TEMPLATE_BOOKING_EXPIRED=

# Twilio (https://console.twilio.com), when SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
# [SECRET]
TWILIO_AUTH_TOKEN=
# Your Twilio number or sender ID, in international format, e.g. +1XXXXXXXXXX
TWILIO_FROM_NUMBER=


# -----------------------------------------------------------------------------
# Email (password reset links, notifications, monitoring alerts). Without SMTP_HOST no email is sent.
# Any SMTP provider works: Amazon SES (Mumbai), Zoho Mail, Brevo, Google Workspace, ...
# -----------------------------------------------------------------------------

SMTP_HOST=
# 587 = STARTTLS (most providers). 465 (implicit TLS) is not supported by the services.
SMTP_PORT=587
SMTP_USERNAME=
# [SECRET]
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Must be an address your SMTP provider lets you send from (verify it with them).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AlakhService


# -----------------------------------------------------------------------------
# Masked calls (optional): Exotel click-to-call (https://my.exotel.com). The platform rings the
# caller, then the other party, from your virtual number, so a customer and a shop never see each
# other's phone numbers (docs/PRIVACY_AND_CONTACT.md). Leave CALL_PROVIDER=none for chat only.
# -----------------------------------------------------------------------------

# none (default: no calling, the apps show only the chat) or exotel.
CALL_PROVIDER=none
# Exotel dashboard > Settings > API Settings: API key, API token and Account SID.
EXOTEL_API_KEY=
# [SECRET]
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Your ExoPhone (the virtual number both sides see), e.g. 08047xxxxxx
EXOTEL_CALLER_ID=
# API host of your account's region: api.exotel.com (Singapore) or api.in.exotel.com (Mumbai).
EXOTEL_SUBDOMAIN=api.in.exotel.com


# -----------------------------------------------------------------------------
# Push notifications (optional): Firebase console > Project settings > Service accounts >
# Generate new private key. Paste the whole JSON file on ONE line, e.g. with:
#   python3 -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))' key.json
# [SECRET]
# -----------------------------------------------------------------------------

FCM_SERVICE_ACCOUNT_JSON=


# -----------------------------------------------------------------------------
# Backups (scripts/backup; see docs/DISASTER_RECOVERY.md)
# -----------------------------------------------------------------------------

# How often to back up every database (hours), and how long to keep backups on this server.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
BACKUP_MIN_KEEP=3
# Where backups are written on this server (relative to the repository folder).
BACKUP_HOST_DIR=./backups

# Off-site copy: name of an rclone remote and folder, used by scripts/deploy/offsite-backup.sh
# (run from cron; see docs/DEPLOYMENT.md). Example: r2:alakh-backups  or  s3mumbai:alakh-backups
# Empty = no off-site copy (preflight warns: a backup on the same disk dies with the disk).
OFFSITE_RCLONE_REMOTE=


# -----------------------------------------------------------------------------
# API gateway limits (optional; defaults shown)
# -----------------------------------------------------------------------------

# Requests per minute per client IP across the API.
RATE_LIMIT_MAX=300
# Sign-in / OTP / password-reset requests per 10 minutes per client IP.
AUTH_RATE_LIMIT_MAX=60


# -----------------------------------------------------------------------------
# Monitoring (optional): Prometheus + Alertmanager + Grafana on this server.
# Set COMPOSE_PROFILES=monitoring to turn it on (adds about 600 MB of memory use).
# -----------------------------------------------------------------------------

COMPOSE_PROFILES=
# [SECRET] Grafana "admin" password; required when monitoring is on.
# Generate: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
# Where alerts go: an email address (uses the SMTP settings above) ...
ALERT_EMAIL_TO=
# ... and/or Telegram: create a bot with @BotFather, send it a message, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates  [SECRET]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
