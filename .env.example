# =============================================================================
# AlakhService – local development settings
#
#   cp .env.example .env      (or `make setup-env`)
#
# docker-compose.yml loads this file into every service container and uses it to fill
# ${...} values in the compose file. Everything here has a working default for a local
# stack; change only what you need. NEVER commit .env.
#
# Production uses a different file with stricter rules: .env.production.example.
#
# Do not set the internal service URLs (AUTH_SERVICE_URL, USER_SERVICE_URL, ...) here.
# Every service already defaults to the compose name (e.g. http://user_service:8000), and a
# value in this file would replace it in every container.
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# development | staging | production | test
ENVIRONMENT=development
NODE_ENV=development
DEBUG=true
TZ=UTC


# =============================================================================
# PORTS AND NETWORK
# =============================================================================

# Interface that PostgreSQL, Redis and the internal services are published on. Most services
# rely on the gateway for authentication, so keep this on loopback.
SERVICE_BIND_ADDRESS=127.0.0.1

# Host port for the gateway; the apps and dashboards use http://localhost:3000/api/v1.
API_GATEWAY_PORT=3000

# Browser origins allowed to call the gateway (the two dashboards' dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Host port of the public site with the legal pages (deploy/site).
# SITE_PORT=8080

# Host ports of the services, for calling one directly while debugging. Defaults:
# AUTH_SERVICE_PORT=8001  USER_SERVICE_PORT=8002  SHOP_SERVICE_PORT=8003  BOOKING_SERVICE_PORT=8004
# PAYMENT_SERVICE_PORT=8005  NOTIFICATION_SERVICE_PORT=8006  TRACKING_SERVICE_PORT=8007
# QUEUE_SERVICE_PORT=8008  ANALYTICS_SERVICE_PORT=8010  DISPUTE_SERVICE_PORT=8011
# TRUST_RISK_SERVICE_PORT=8012  ADMIN_SERVICE_PORT=8013  COMPLIANCE_SERVICE_PORT=8014
# PRICING_ENGINE_PORT=8015  SERVICE_CATALOG_PORT=8016


# =============================================================================
# DATABASE – PostgreSQL
# =============================================================================

# One server, one database per service (infra/postgres/init-databases.sql).
# If a local PostgreSQL already holds 5432, pick another host port, e.g. 15432.
POSTGRES_PORT=5432
POSTGRES_DB=alakhservice
POSTGRES_USER=alakh
POSTGRES_PASSWORD=changeme_strong_password

# Used by scripts run on the host; each container gets its own database URL from compose.
DATABASE_URL=postgresql+asyncpg://alakh:changeme_strong_password@localhost:5432/alakhservice


# =============================================================================
# CACHE – Redis
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://:changeme_redis_password@localhost:6379/0


# =============================================================================
# AUTHENTICATION
# =============================================================================

# Signs and checks every access token (HS256); shared by the gateway and the services.
# Generate with `openssl rand -hex 32`.
JWT_SECRET_KEY=changeme_jwt_secret_min_32_chars_long_very_secret

# Shared secret for service-to-service calls (booking/payment -> notification). Generate with
# `openssl rand -hex 32`; without it no booking or payment notifications are sent.
INTERNAL_API_KEY=changeme_internal_api_key

# With no SMS or email provider set up, one-time codes and password reset tokens are written to
# the auth_service log so you can sign in locally. Never true in production.
LOG_OTP_CODES=true
LOG_PASSWORD_RESET_TOKENS=true

# Page that password reset emails link to (the shop dashboard's reset page by default)
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Terms version sign-up must accept, and where the legal pages are (deploy/site; https://<DOMAIN> live)
TERMS_VERSION=2026-10
LEGAL_BASE_URL=http://localhost:8080


# =============================================================================
# EMAIL – SMTP (optional)
# =============================================================================

# With no SMTP_HOST, no email is sent (reset tokens are logged, see above). To send real mail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=
# Sender used by auth_service and notification_service
SMTP_FROM_EMAIL=noreply@alakhservice.com
SMTP_FROM_NAME=AlakhService


# =============================================================================
# SMS AND PUSH (optional)
# =============================================================================

# twilio, msg91 or none (MSG91 needs MSG91_AUTH_KEY, MSG91_SENDER_ID and DLT template ids;
# see .env.production.example for the full list)
SMS_PROVIDER=none

# Twilio, read by auth_service and notification_service when SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555555555

# Reports to providers on WhatsApp, through MSG91 (docs/WHATSAPP_REPORTS.md). Without these they
# go by email only.
# MSG91_WHATSAPP_NUMBER=91XXXXXXXXXX
# MSG91_WHATSAPP_TEMPLATE_REPORT=provider_report
# MSG91_WHATSAPP_NAMESPACE=
# MSG91_WHATSAPP_LANGUAGE=en

# Firebase Cloud Messaging (push notifications, HTTP v1 API). notification_service reads a
# service-account key (Firebase console > Project settings > Service accounts); the project id
# comes from the file. Without it, no push notifications are sent.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json


# =============================================================================
# PAYMENTS – Razorpay
# =============================================================================

# Use your Razorpay *test* keys locally. Webhook URL: https://<gateway>/api/v1/webhooks/razorpay
# with events payment.captured and payment.failed; the webhook secret is the one set in the
# Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_changeme
RAZORPAY_KEY_SECRET=changeme_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=changeme_razorpay_webhook_secret


# =============================================================================
# MAPS
# =============================================================================

# Read by the Android build (apps/mobile_app/android/README.md) when not in local.properties.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key


# =============================================================================
# BACKUPS (the `backup` container)
# =============================================================================

# BACKUP_HOST_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
# BACKUP_MIN_KEEP=3
# Command run after each verified backup to copy it off this machine (docs/DISASTER_RECOVERY.md)
# BACKUP_UPLOAD_COMMAND=


# =============================================================================
# DEVELOPMENT
# =============================================================================

# Extra uvicorn flags for every service; docker-compose.dev.yml sets --reload.
# UVICORN_EXTRA_ARGS=

# Tag for `make build-images` (defaults to the project version).
# DOCKER_TAG=latest
