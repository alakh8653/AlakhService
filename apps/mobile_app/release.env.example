# Settings for the Android release build. Copy to release.env (git-ignored), fill in, then run
#   make build-mobile-release
# The build refuses to start while any value is missing or still a placeholder.
API_BASE_URL=https://api.<DOMAIN>
LEGAL_BASE_URL=https://<DOMAIN>
# Must match APP_LINK_DOMAIN in app_links.xcconfig.
APP_LINK_DOMAIN=<DOMAIN>
SUPPORT_EMAIL=support@<DOMAIN>
# International format, no spaces.
SUPPORT_PHONE=+91XXXXXXXXXX
