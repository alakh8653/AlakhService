# Override root .gitignore so Flutter source in lib/ is tracked
!lib/
!lib/**

# Flutter / Dart generated files (do not track)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.g.dart
*.freezed.dart

# Machine-specific iOS files regenerated by `flutter pub get`
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
